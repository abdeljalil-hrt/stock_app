<h1 class="text-3xl font-bold"><%= ui("Movement history") %></h1>
<%= form_with url: history_index_path, method: :get, class: "my-5 flex max-w-xl gap-2 print:hidden" do |form| %>
  <%= form.search_field :reference, value: @reference, placeholder: ui("Filter by order / tracking reference"), class: "min-w-0 flex-1 rounded border px-3 py-2" %>
  <%= form.submit ui("Filter"), class: "cursor-pointer rounded bg-slate-800 px-4 py-2 font-semibold text-white" %>
  <% if @reference.present? %><%= link_to ui("Clear"), history_index_path, class: "self-center text-blue-700 underline" %><% end %>
<% end %>

<div class="overflow-x-auto rounded-lg border bg-white">
  <table class="w-full text-left">
    <thead class="bg-slate-100 text-sm uppercase text-slate-600">
      <tr><th class="px-4 py-3"><%= ui("Time") %></th><th class="px-4 py-3">SKU</th><th class="px-4 py-3"><%= ui("Action") %></th><th class="px-4 py-3"><%= ui("Quantity") %></th><th class="px-4 py-3"><%= ui("Reference") %></th><th class="px-4 py-3"><%= ui("Note") %></th></tr>
    </thead>
    <tbody>
      <% @movements.each do |movement| %>
        <tr class="border-t">
          <td class="whitespace-nowrap px-4 py-3"><%= l(movement.created_at, format: :short) %></td>
          <td class="px-4 py-3 font-mono"><%= movement.variant.sku %></td>
          <td class="px-4 py-3"><%= ui(movement.kind.humanize) %></td>
          <td class="px-4 py-3"><%= movement.quantity %></td>
          <td class="px-4 py-3"><%= movement.reference.presence || "—" %></td>
          <td class="px-4 py-3"><%= movement.note %></td>
        </tr>
      <% end %>
      <% if @movements.empty? %>
        <tr><td colspan="6" class="px-4 py-6 text-center text-slate-500"><%= ui("No movements found.") %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
