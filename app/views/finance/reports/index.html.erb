<div class="mb-5 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-lg font-semibold"><%= ui("Reports") %></h1>
    <p class="mt-1 text-xs text-gray-500"><%= @month.strftime("%B %Y") %></p>
  </div>
  <%= link_to ui("Export CSV"), export_finance_reports_path(month: @month.strftime("%Y-%m")), class: "rounded-md border border-gray-200 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
</div>

<nav class="mb-5 flex flex-wrap items-center gap-3 text-sm" aria-label="<%= ui("Report month") %>">
  <%= link_to "← #{ui("Previous month")}", finance_reports_path(month: @month.prev_month.strftime("%Y-%m")), class: "text-indigo-600 hover:text-indigo-700" %>
  <%= form_with url: finance_reports_path, method: :get, local: true, class: "flex items-center gap-2" do %>
    <label for="report-month" class="sr-only"><%= ui("Select month") %></label>
    <input id="report-month" type="month" name="month" value="<%= @month.strftime("%Y-%m") %>" class="rounded-md border border-gray-200 px-2 py-1.5 text-sm">
    <button class="rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50"><%= ui("Go") %></button>
  <% end %>
  <%= link_to "#{ui("Next month")} →", finance_reports_path(month: @month.next_month.strftime("%Y-%m")), class: "text-indigo-600 hover:text-indigo-700" %>
</nav>

<section class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="<%= ui("Monthly summary") %>">
  <% [
    [ui("Income"), @report.income_cents],
    [ui("Cost of goods"), @report.shipped_cogs_cents],
    [ui("Returns cost"), @report.returns_cents],
    [ui("Gross margin"), @report.gross_margin_cents],
    [ui("Running expenses"), @report.running_expenses_cents],
    [ui("Net profit"), @report.net_profit_cents],
    [ui("Giving (5%)"), @report.giving_cents]
  ].each do |label, amount| %>
    <article class="rounded-lg border border-gray-200 p-4">
      <p class="text-xs text-gray-500"><%= label %></p>
      <p class="mt-1 text-2xl font-semibold tabular-nums"><%= format_money(amount) %></p>
    </article>
  <% end %>
  <article class="rounded-lg border border-gray-200 p-4">
    <p class="text-xs text-gray-500"><%= ui("Gross margin %") %></p>
    <p class="mt-1 text-2xl font-semibold tabular-nums"><%= @report.gross_margin_percent.nil? ? "—" : "#{@report.gross_margin_percent}%" %></p>
  </article>
</section>

<section class="mt-6 rounded-lg border border-gray-200 p-4">
  <h2 class="mb-3 text-sm font-medium"><%= ui("Running expenses by category") %></h2>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[600px] text-left text-sm">
      <thead class="border-b border-gray-200 text-xs uppercase text-gray-500">
        <tr><th class="py-2"><%= ui("Category") %></th><th class="py-2 text-right"><%= ui("Amount") %></th><th class="py-2 text-right"><%= ui("% of total") %></th><th class="py-2 text-right"><%= ui("Change vs previous month") %></th></tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @report.expenses_by_category.each do |row| %>
          <tr>
            <td class="py-2"><%= row.category.name %></td>
            <td class="py-2 text-right tabular-nums"><%= format_money(row.amount_cents) %></td>
            <td class="py-2 text-right tabular-nums"><%= row.percent %>%</td>
            <td class="py-2 text-right tabular-nums"><%= format_money(row.change_cents) %><%= row.change_percent.nil? ? "" : " (#{row.change_percent}%)" %></td>
          </tr>
        <% end %>
        <% if @report.expenses_by_category.empty? %>
          <tr><td colspan="4" class="py-5 text-center text-xs text-gray-500"><%= ui("No running expenses for this month.") %></td></tr>
        <% end %>
      </tbody>
      <% unless @report.expenses_by_category.empty? %>
        <tfoot class="border-t border-gray-200 text-sm font-medium"><tr><td class="py-2"><%= ui("Total") %></td><td class="py-2 text-right tabular-nums"><%= format_money(@report.running_expenses_cents) %></td><td class="py-2 text-right tabular-nums">100%</td><td></td></tr></tfoot>
      <% end %>
    </table>
  </div>
</section>

<section class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <div class="rounded-lg border border-gray-200 p-4">
    <h2 class="mb-3 text-sm font-medium"><%= ui("Pot allocations for the month") %></h2>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-200 text-xs uppercase text-gray-500"><tr><th class="py-2"><%= ui("Pot") %></th><th class="py-2 text-right"><%= ui("Added") %></th><th class="py-2 text-right"><%= ui("Spent") %></th><th class="py-2 text-right"><%= ui("Net") %></th></tr></thead>
        <tbody class="divide-y divide-gray-100">
          <% @report.pot_allocations.each do |row| %>
            <tr><td class="py-2"><%= row.pot.name %></td><td class="py-2 text-right tabular-nums"><%= format_money(row.income_cents) %></td><td class="py-2 text-right tabular-nums"><%= format_money(row.expense_cents) %></td><td class="py-2 text-right tabular-nums"><%= format_money(row.net_cents) %></td></tr>
          <% end %>
          <% if @report.pot_allocations.empty? %><tr><td colspan="4" class="py-5 text-center text-xs text-gray-500"><%= ui("No pot allocations for this month.") %></td></tr><% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="rounded-lg border border-gray-200 p-4">
    <h2 class="text-sm font-medium"><%= ui("Close month") %></h2>
    <p class="mt-1 text-xs text-gray-500"><%= ui("Giving is 5% of positive net profit and is transferred from Profit safety to Giving.") %></p>
    <% if @closure %>
      <p class="mt-3 text-sm text-green-700" role="status"><%= ui("Month closed.") %> <%= ui("Given") %>: <span class="tabular-nums"><%= format_money(@closure.giving_cents) %></span></p>
      <button type="button" disabled class="mt-3 cursor-not-allowed rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-400"><%= ui("Month already closed") %></button>
    <% else %>
      <%= button_to ui("Close month"), close_month_finance_reports_path(month: @month.strftime("%Y-%m")), method: :post, class: "mt-3 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" %>
    <% end %>
  </div>
</section>

<section class="mt-6 rounded-lg border border-gray-200 p-4">
  <h2 class="mb-3 text-sm font-medium"><%= ui("Transactions") %></h2>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[700px] text-left text-sm">
      <thead class="border-b border-gray-200 text-xs uppercase text-gray-500"><tr><th class="py-2"><%= ui("Date") %></th><th class="py-2"><%= ui("Category") %></th><th class="py-2"><%= ui("Kind") %></th><th class="py-2 text-right"><%= ui("Amount") %></th><th class="py-2"><%= ui("Account") %></th><th class="py-2"><%= ui("Note") %></th></tr></thead>
      <tbody class="divide-y divide-gray-100">
        <% @transactions.each do |transaction| %>
          <tr><td class="py-2"><%= l(transaction.date, format: :short) %></td><td class="py-2"><%= transaction.category.name %></td><td class="py-2"><%= ui(transaction.kind.humanize) %></td><td class="py-2 text-right tabular-nums"><%= format_money(transaction.amount_cents) %></td><td class="py-2"><%= transaction.account.name %></td><td class="py-2"><%= transaction.note.presence || "—" %></td></tr>
        <% end %>
        <% if @transactions.empty? %><tr><td colspan="6" class="py-6 text-center text-xs text-gray-500"><%= ui("No transactions for this month.") %></td></tr><% end %>
      </tbody>
    </table>
  </div>
</section>
