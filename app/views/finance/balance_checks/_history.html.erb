<div class="overflow-x-auto">
  <table class="w-full min-w-[600px] text-left text-sm">
    <thead class="border-b border-gray-200 text-xs uppercase text-gray-500">
      <tr><th class="py-2"><%= ui("Date") %></th><th class="py-2"><%= ui("Account") %></th><th class="py-2 text-right"><%= ui("Expected") %></th><th class="py-2 text-right"><%= ui("Real") %></th><th class="py-2 text-right"><%= ui("Difference") %></th></tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% checks.each do |check| %>
        <tr>
          <td class="py-2"><%= link_to l(check.checked_on, format: :short), finance_balance_check_path(check), class: "text-indigo-600 hover:text-indigo-700" %></td>
          <td class="py-2"><%= check.account.name %></td>
          <td class="py-2 text-right tabular-nums"><%= format_money(check.expected_cents) %></td>
          <td class="py-2 text-right tabular-nums"><%= format_money(check.real_cents) %></td>
          <td class="py-2 text-right tabular-nums"><%= check.difference_cents.zero? ? ui("Balanced") : format_money(check.difference_cents) %></td>
        </tr>
      <% end %>
      <% if checks.empty? %><tr><td colspan="5" class="py-6 text-center text-xs text-gray-500"><%= ui("No balance checks yet.") %></td></tr><% end %>
    </tbody>
  </table>
</div>
