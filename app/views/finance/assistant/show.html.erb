<div class="mx-auto max-w-3xl">
  <h1 class="text-2xl font-semibold text-gray-900"><%= ui("Business assistant") %></h1>
  <p class="mt-2 text-sm text-gray-600"><%= ui("Ask about inventory, stock movements, and the existing monthly finance reports. This assistant is read-only.") %></p>

  <% if @error.present? %>
    <div class="mt-5 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"><%= @error %></div>
  <% end %>

  <%= form_with url: finance_assistant_path, method: :post, class: "mt-6 space-y-3" do |form| %>
    <%= form.label :question, ui("Question"), class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :question, value: @question, maxlength: Finance::AssistantController::MAX_QUESTION_LENGTH, rows: 4, class: "block w-full rounded-md border-gray-300 shadow-sm" %>
    <%= form.submit ui("Ask assistant"), class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>

  <% if @answer.present? %>
    <section class="mt-6 rounded-md border border-gray-200 bg-white p-5">
      <h2 class="text-sm font-semibold text-gray-900"><%= ui("Analysis") %></h2>
      <div class="mt-3 whitespace-pre-wrap text-sm text-gray-700"><%= @answer %></div>
    </section>
  <% end %>
</div>
